{
  "name": "@textdb/server",
  "version": "0.1.0",
  "private": true,
  "description": "HTTP + SSE server for the textdb live corpus app",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --no-warnings --import tsx src/main.ts",
    "dev": "node --no-warnings --import tsx --watch src/main.ts",
    "open": "node --no-warnings --import tsx scripts/open.ts",
    "seed": "node --no-warnings --import tsx scripts/seed.ts",
    "agent-sim": "node --no-warnings --import tsx scripts/agent-sim.ts",
    "test": "node --no-warnings --import tsx --test \"test/*.test.ts\"",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@textdb/node": "file:../../packages/textdb",
    "hono": "^4.13.7",
    "tsx": "^4.23.13",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "@types/yazl": "^3.3.1",
    "typescript": "^7.0.2"
  }
}
