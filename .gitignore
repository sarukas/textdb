/target
**/target
*.db
*.db-wal
*.db-shm

# Benchmark scratch: whatever --out and --work point at, plus run logs. A run worth
# keeping is copied into bench/results/<id>/ and recorded in bench/RESULTS.md, so nothing
# under these paths is ever the record of anything.
/bench/out*
/bench/data*
/bench/*.log

# Node
node_modules/
/node/**/dist/
*.tsbuildinfo

# Python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
